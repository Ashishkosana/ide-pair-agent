{
  "name": "ide-pair-agent",
  "displayName": "IDE Pair Agent",
  "description": "Share editor selection, file, and diagnostics with a local pair-agent bridge.",
  "version": "0.1.0",
  "publisher": "ashishkosana",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "idePairAgent.shareSelection",
        "title": "Pair Agent: Share Selection"
      },
      {
        "command": "idePairAgent.shareFileDiagnostics",
        "title": "Pair Agent: Share File + Diagnostics"
      },
      {
        "command": "idePairAgent.ask",
        "title": "Pair Agent: Ask Pair Agent"
      }
    ],
    "configuration": {
      "title": "IDE Pair Agent",
      "properties": {
        "idePairAgent.bridgeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Base URL of the local pair-agent bridge. Must stay on loopback for M1."
        },
        "idePairAgent.pollMs": {
          "type": "number",
          "default": 1000,
          "description": "How often to poll GET /v1/replies/latest after sending context."
        },
        "idePairAgent.pollTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "How long to wait for an assistant reply before giving up."
        },
        "idePairAgent.maxFileChars": {
          "type": "number",
          "default": 100000,
          "description": "Cap on file content / selection size posted to the bridge."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
