# Local pair-agent bridge. Copy to .env and adjust.
# Never commit real webhook URLs that embed secrets.

HOST=127.0.0.1
PORT=8765

# JSONL drop for an assistant (or a human) to tail.
MAILBOX_DIR=mailbox

# Optional. If set, each accepted context event is POSTed as JSON to this URL.
# Point this at whatever inbound webhook your desktop assistant / automation
# already exposes. This repo does not invent a vendor-specific Bot API.
# ASSISTANT_WEBHOOK_URL=https://example.invalid/hooks/ide-context

WEBHOOK_TIMEOUT_SECONDS=5
MAX_PAYLOAD_CHARS=200000
